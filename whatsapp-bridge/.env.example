# Port the bridge listens on. cPanel Node.js Selector usually injects PORT for you;
# leave this commented out if you're running there. For local/VPS, set explicitly.
# PORT=3000

# Required: the same secret you put in Laravel's .env as WHATSAPP_BRIDGE_KEY.
# Use a long random string, e.g. `openssl rand -hex 32`.
API_KEY=change-me-to-a-long-random-string

# Optional: comma-separated origins allowed in CORS. Defaults to "*" (Laravel-only access via API key).
# CORS_ORIGINS=https://system.wp-ar.net

# Optional: where Baileys saves auth state. Default: ./auth_info
# AUTH_DIR=./auth_info
